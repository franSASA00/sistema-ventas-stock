# Base de datos
# Local (desarrollo): usa SQLite automaticamente si no seteas DATABASE_URL
# Produccion (Render): pegar la Internal Database URL de Postgres que da Render
DATABASE_URL=

# Seguridad
SECRET_KEY=cambiar-esto-por-una-clave-larga-y-random
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Usuario servidor inicial (se crea solo la primera vez que arranca la app)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-esta-clave
